{
  "name": "football-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:import": "node scripts/validate-import.mjs",
    "calibrate:full": "set CALIBRATION_FULL=1&& vitest run src/test/calibrationFullMatch.test.ts",
    "calibrate:matrix": "set CALIBRATION_MATRIX=1&& vitest run src/test/calibrationMatrix.test.ts",
    "test:stability": "set STABILITY_FULL=1&& vitest run src/test/stabilityFullMatch.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
